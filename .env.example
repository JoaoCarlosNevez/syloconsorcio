# SyloCRM 2.0 — Environment Variables Reference
# Copy the relevant section to the .env file inside each app.
# NEVER commit .env files with real credentials.

# ─── apps/api ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database — required when infrastructure layer is active
DATABASE_URL=postgresql://postgres:password@localhost:5432/sylocrm

# Supabase — required when auth/storage adapters are active
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Observability — optional, activates Sentry error tracking
SENTRY_DSN=https://your-dsn@sentry.io/123

# ─── apps/web ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
